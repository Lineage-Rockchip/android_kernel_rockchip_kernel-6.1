# Orange Pi 5 Pro deltas on top of
#   rockchip_defconfig + kernel/configs/android-14.config + rk3588.config + rk3588_android.config

# Wi-Fi (AP6256) is the external bcmdhd module
# CONFIG_AP6XXX is not set
# CONFIG_IKHEADERS is not set

# Motorcomm YT6801 1GbE on PCIe; module, loaded by /vendor/etc/init.insmod.cfg
CONFIG_NET_VENDOR_MOTORCOMM=y
CONFIG_FUXI=m
# CONFIG_R8168 is not set
# CONFIG_REALTEK_PHY is not set

# Khadas Edge-2L hardware this board does not have
# CONFIG_KHADAS_WATCHDOG is not set
# CONFIG_TOUCHSCREEN_HYN is not set
# CONFIG_VIDEO_IMX585 is not set
# CONFIG_VIDEO_IMX678 is not set
# CONFIG_VIDEO_OS08A10 is not set

# CONFIG_ROCKCHIP_DRM_DEBUG is not set
